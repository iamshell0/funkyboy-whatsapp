# LLM backend (OpenAI-compatible). Comma-separate to enable failover —
# the bot tries each URL in order on connection error or 5xx.
# Example: LLM_URL=https://primary/v1,https://fallback/v1
LLM_URL=http://localhost:8080/v1
LLM_MODEL=qwen3.5-9b
LLM_API_KEY=sk-local

# Image generation (optional). Leave IMG_URL blank to disable.
# Expects:
#   POST {IMG_URL}/v1/generate     → { job_id }
#   GET  {IMG_URL}/v1/jobs/{id}    → { status, images:[filename] }
#   GET  {IMG_URL}/outputs/{file}  → PNG bytes
IMG_URL=

# Default variant
IMG_MODEL=
IMAGE_TRIGGERS=/imagen,/img,/draw

# Add more variants by suffixing both env vars with the same key.
# Example: a "photo" variant pinned to a photorealistic checkpoint.
# IMG_MODEL_PHOTO=
# IMAGE_TRIGGERS_PHOTO=/foto,/photo,/real

THINKING_MSG=Thinking...
IMAGE_THINKING_MSG=Generando imagen...

# --- Personas ---
# Comma-separated list of persona names. Each runs as its own WhatsApp account
# inside the same container. Names must be lowercase, [a-z][a-z0-9_]*.
#
# Routing:
#   - DM to a persona's WhatsApp account → no trigger required, the persona replies to anything.
#   - Group message → only replies if the message contains the persona's group trigger
#     (default "@<name>", case-insensitive). The trigger is stripped before passing to the LLM.
#
# For each NAME, the bot loads the system prompt from prompts/<name>.md.
# If that file is missing, it falls back to a {NAME}_PROMPT env var.
# Optional overrides: {NAME}_GROUP_TRIGGER (default "@<name>") and {NAME}_MODEL.

PERSONAS=alice,bob

# ALICE_GROUP_TRIGGER=@alice
# ALICE_MODEL=qwen3.5-9b
# BOB_GROUP_TRIGGER=@bob
# BOB_MODEL=qwen3.5-9b
